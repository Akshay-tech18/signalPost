# 1. Python cache files
__pycache__/
*.py[cod]
*$py.class
*.so

# 2. Virtual environments
# Ignore the folder where your Python dependencies are installed locally
.venv/
venv/
env/

# 3. Environment variables / Secrets
# NEVER commit your secrets!
.env
.env.*
!.env.example

# 4. OS-generated files (Since you are on a Mac)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# 5. Project-specific outputs
# The 'out/' directory looks like it contains generated data (e.g., refresh-demo.json)
# If this data is generated by your scripts, it shouldn't be tracked.
out/
out_backup_73/
backup_73_codebase/
*.tmp

# 6. Testing and Tooling Caches
# (If you run tests or linters, they create these cache folders)
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# 7. IDEs and Editors
.vscode/
.idea/
*.swp

